APP_ENV=development
DATABASE_URL=postgresql+psycopg://llm_harness:local-development-only@localhost:5432/llm_harness
CORS_ORIGINS=["http://localhost:5173"]

# Use openai for real model requests; demo requires no API key.
LLM_PROVIDER=demo
OPENAI_BASE_URL=https://api.openai.com/v1
# Set locally only. Never commit a real API key.
OPENAI_API_KEY=your-openai-api-key-here
# Recommendation assistant always uses OpenAI, independently of LLM_PROVIDER.
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_TIMEOUT_SECONDS=30
